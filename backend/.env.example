# Local/Hardhat dev
RPC_URL=http://127.0.0.1:8545
PRIVATE_KEY=your_local_dev_private_key

# Sepolia testnet
# For now, the manufacturer wallet is treated as the default admin wallet.
# The deployment flow and role scripts prefer the manufacturer key as the deployer/admin,
# so any contract deployed with SEPOLIA_PRIVATE_KEY_MANUFACTURER will automatically become admin.
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_PROJECT_ID
SEPOLIA_PRIVATE_KEY_MANUFACTURER=0xMANUFACTURER_PRIVATE_KEY
SEPOLIA_PRIVATE_KEY_DISTRIBUTOR=0xDISTRIBUTOR_PRIVATE_KEY
SEPOLIA_MANUFACTURER_ADDRESS=0xMANUFACTURER_WALLET_ADDRESS
SEPOLIA_DISTRIBUTOR_ADDRESS=0xDISTRIBUTOR_WALLET_ADDRESS
SEPOLIA_CHAIN_ID=11155111
SEPOLIA_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Contract deploy metadata
CONTRACT_NAME=PharmaTree
