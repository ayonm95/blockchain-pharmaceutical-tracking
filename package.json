{
  "name": "pharmatree-root",
  "version": "1.0.0",
  "private": true,
  "description": "PharmaTree: Blockchain-Based Pharmaceutical Supply Chain Tracking & Verification System",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "start": "npm --prefix frontend run start",
    "lint": "npm --prefix frontend run lint",
    "compile": "npm --prefix backend run compile",
