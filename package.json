    "test:all": "npm --prefix backend test && npm --prefix frontend run build",
    "deploy:sepolia": "npm --prefix backend run deploy:sepolia"
  },
  "keywords": [
    "blockchain",
    "pharmaceutical",
    "supply-chain",
